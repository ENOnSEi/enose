# ===========================================================================
# .gitignore de la RAÍZ del repo (monorepo compartido).
# El proyecto de la nariz electrónica vive en implementacion/ y tiene su propio
# implementacion/.gitignore con las reglas específicas del pipeline.
# Aquí solo van reglas generales que aplican a todo el repositorio.
# ===========================================================================

# Claude Code — settings locales de máquina (no compartir)
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
build/
dist/

# Entornos virtuales
venv/
env/
.venv/
.env

# Tests y cobertura
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Logs
*.log

# IDE / Sistema operativo
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
