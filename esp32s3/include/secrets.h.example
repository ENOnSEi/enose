// Copy this file to secrets.h and fill in your own values.
// secrets.h is gitignored (see .gitignore / repo-root .gitignore).
#pragma once

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// IP (or hostname) of the machine running the Mosquitto broker on the same WiFi.
// This is the host where `docker compose up` runs the broker.
#define MQTT_BROKER_HOST "192.168.1.100"
#define MQTT_BROKER_PORT 1883

// Optional broker credentials. Leave empty to connect anonymously.
#define MQTT_USERNAME ""
#define MQTT_PASSWORD ""
