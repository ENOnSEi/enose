DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/enose_db
# For Neon (or any external Postgres over TLS) use the asyncpg driver and the
# asyncpg-style ssl param. Note: asyncpg does NOT accept libpq params such as
# sslmode or channel_binding — use `?ssl=require` instead.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/neondb?ssl=require
APP_NAME=ENose API
DEBUG=false

# --- Transporte con la placa ---
# "mqtt" usa el broker Mosquitto; "ws" usa la conexión WebSocket directa (legacy)
BOARD_TRANSPORT=mqtt
ESP32_WS_URL=ws://192.168.1.135:81

# --- MQTT (broker Mosquitto) ---
# En docker compose el host es el nombre del servicio del broker: "mosquitto".
# Para ejecutar la API fuera de compose usa la IP/host donde corra el broker.
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_READINGS_TOPIC=enose/readings
MQTT_COMMANDS_TOPIC=enose/commands
MQTT_USERNAME=
MQTT_PASSWORD=
SENSOR_NAMES=["tgs2620","tgs2611","tgs2602","tgs2600"]
SENSOR_PINS=["PIN_TGS2620","PIN_TGS2611","PIN_TGS2602","PIN_TGS2600"]

# --- Observer / analizador de señal ---
OBSERVER_WINDOW_SECONDS=4.0
OBSERVER_SLOPE_THRESHOLD=7.5
OBSERVER_HYSTERESIS=0.15
OBSERVER_CONFIRM_SECONDS=1.0
OBSERVER_POLICY=all
OBSERVER_FETCH_LIMIT=300
OBSERVER_POLL_INTERVAL=1.0
OBSERVER_MIN_MEDICION_SECONDS=30.0
